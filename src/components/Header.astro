---
import { siteConfig } from '../config/site';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand">
      {/*
        This is a tightly-cropped version of public/images/logo.png,
        made specifically for the header. If you replace logo.png with
        a new design, re-crop a version of it to public/images/logo-header.png
        (trimmed to the logo artwork, no extra white space) — see the README.
      */}
      <img
        src="/images/logo-header.png"
        alt={`${siteConfig.businessName} — ${siteConfig.tagline}`}
        class="site-header__logo"
        width="992"
        height="557"
      />
      <span class="visually-hidden">{siteConfig.businessName}</span>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/gallery">Gallery</a>
      <a href="/privacy">Privacy</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-text);
    min-width: 0;
  }

  .site-header__logo {
    width: auto;
    height: 3rem;
    object-fit: contain;
  }

  .site-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-left: auto;
  }

  .site-nav a {
    text-decoration: none;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--color-accent-dark);
  }

  @media (max-width: 28rem) {
    .site-header__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-nav {
      margin-left: 0;
    }
  }

  @media (min-width: 40rem) {
    .site-header__logo {
      height: 3.5rem;
    }
  }
</style>
